{
  "dyngenie3": {
    "name": "dynGENIE3",
    "docker_image": "adriansegura99/inference-tools_dyngenie3:1.0.0",
    "extra_inputs": [
      "column_descriptors",
      "tf_list"
    ],
    "outputs": {
      "directed": true,
      "sign": "none"
    },
    "runtime_resources": {
      "threading": {
        "supported": true,
        "default_threads": 1,
        "max_threads": null,
        "upstream_mapping": "nthreads controls parallel targets. Each forest and its BLAS pools use one thread."
      }
    },
    "params": {
      "alpha": "from_data",
      "tree_method": "RF",
      "K": "sqrt",
      "ntrees": 1000,
      "compute_quality_scores": false,
      "save_models": false,
      "maxcount": "all",
      "seed": 1729
    }
  },
  "swing": {
    "name": "SWING",
    "docker_image": "adriansegura99/inference-tools_swing:1.0.0",
    "extra_inputs": [
      "column_descriptors",
      "tf_list"
    ],
    "outputs": {
      "directed": true,
      "sign": "none"
    },
    "runtime_resources": {
      "threading": {
        "supported": true,
        "default_threads": 1,
        "max_threads": null,
        "upstream_mapping": "RandomForest uses n_jobs for each forest. Windows and targets run sequentially. Lasso, Dionesus and native BLAS use one thread."
      }
    },
    "params": {
      "window_type": "RandomForest",
      "window_width": 7,
      "min_lag": 1,
      "max_lag": 2,
      "step_size": 1,
      "zscore": true,
      "n_trees": 100,
      "alpha": null,
      "pcs": null,
      "n_bootstraps": 10,
      "n_alphas": 20,
      "noise": 0.2,
      "null_alpha": null,
      "null_alpha_max": 10000,
      "null_alpha_min_step": 1e-09,
      "alpha_cv_folds": 10,
      "alpha_cv_method": "modelQ2",
      "alpha_grid": null,
      "n_permutations": 0,
      "lag_method": "mean_mean",
      "sort_by": "mean",
      "seed": 1729,
      "maxcount": "all"
    }
  },
  "bixgboost": {
    "name": "BiXGBoost",
    "docker_image": "adriansegura99/inference-tools_bixgboost:1.0.0",
    "extra_inputs": [
      "column_descriptors"
    ],
    "outputs": {
      "directed": true,
      "sign": "none"
    },
    "runtime_resources": {
      "threading": {
        "supported": true,
        "default_threads": 1,
        "max_threads": null,
        "upstream_mapping": "nthread controls native XGBoost within each sequential regression. BLAS uses one thread."
      }
    },
    "params": {
      "p_lambda": 0,
      "p_alpha": 1,
      "timelag": 2,
      "seed": 1729
    }
  },
  "pfbnet": {
    "name": "PFBNet",
    "docker_image": "adriansegura99/inference-tools_pfbnet:1.0.0",
    "extra_inputs": [
      "column_descriptors",
      "tf_list"
    ],
    "outputs": {
      "directed": true,
      "sign": "none"
    },
    "runtime_resources": {
      "threading": {
        "supported": true,
        "default_threads": 1,
        "max_threads": null,
        "upstream_mapping": "nthread controls XGBoost within each sequential target fit. BLAS uses one thread."
      }
    },
    "params": {
      "k": 2,
      "alpha": 0.45,
      "iter_num": 1000,
      "seed": 1729
    }
  },
  "nimce": {
    "name": "NIMCE",
    "docker_image": "adriansegura99/inference-tools_nimce:1.0.0",
    "extra_inputs": [
      "column_descriptors"
    ],
    "outputs": {
      "directed": true,
      "sign": "none"
    },
    "runtime_resources": {
      "threading": {
        "supported": true,
        "default_threads": 1,
        "max_threads": 128,
        "upstream_mapping": "Threads limit Octave OpenBLAS and OpenMP before startup. The Python adapter and gene loops are serial."
      }
    },
    "params": {
      "window_num": 3,
      "time_lag": 2,
      "h": 0.45,
      "lamda2": 0.04,
      "seed": 1729
    }
  },
  "hstxgb": {
    "name": "HSTXGB",
    "docker_image": "adriansegura99/inference-tools_hstxgb:1.0.0",
    "extra_inputs": [
      "column_descriptors",
      "tf_list"
    ],
    "outputs": {
      "directed": true,
      "sign": "none"
    },
    "runtime_resources": {
      "threading": {
        "supported": true,
        "default_threads": 1,
        "max_threads": null,
        "upstream_mapping": "Threads limit parallel CV workers with one thread per estimator, and set nthread for the final XGBoost fit."
      }
    },
    "params": {
      "k": 2,
      "alpha": 0.49,
      "iter_num": 500,
      "seed": 1729
    }
  },
  "greynet": {
    "name": "GreyNet",
    "docker_image": "naniwa/greynet-series:1.0.0",
    "extra_inputs": [
      "column_descriptors"
    ],
    "outputs": {
      "directed": true,
      "sign": "none"
    },
    "runtime_resources": {
      "threading": {
        "supported": true,
        "default_threads": 1,
        "max_threads": null,
        "upstream_mapping": "Threads set RandomForest or XGBoost n_jobs, or the BLAS budget for linear regressors. Series and targets run sequentially."
      }
    },
    "params": {
      "regressor": "RF",
      "grey_threshold": 0.4,
      "max_win": 15,
      "win_len": 0,
      "lag": 1,
      "rho": 0.5,
      "seed": 1729
    }
  }
}
